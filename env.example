# ===== 淘宝库存监控 · 数据源配置 =====
# 复制本文件为 .env 并按需填写；不填则继续使用内置 mock 数据
# 修改后需重启 server.js 生效
# 【必填】ERP 库存接口地址（返回 JSON 数组，或含 data/list/rows/result 字段的对象）
# 怎么找这个地址：打开 ERP 网页 → F12 → Network → 刷新库存页 → 找返回库存列表的那个 XHR 请求的 URL
ERP_API_URL=
# 【选填】鉴权（三选一，按你 ERP 接口要求）
ERP_TOKEN=        # 会作为请求头 Authorization: Bearer <token> 发送
ERP_API_KEY=      # 会作为请求头 X-API-Key: <key> 发送
ERP_COOKIE=       # 会作为请求头 Cookie: <cookie> 发送（接口需要登录态时用）
# 【必填·关键】公司/店铺 ID（cId）。快麦 warehouseStockList 靠它区分店铺，
# 不填会回退到默认(测试)店铺，看板全是 测试2/菜鸟测试3 这类假数据。
# 取值：F12 → Network → 库存列表请求的 Request Payload 里的 cId
ERP_CID=
# 【选填】仓库 ID（warehouseIds）。留空=不限定；填了只拉该仓库。
# 取值同上，Payload 里的 warehouseIds。例：116959
ERP_WAREHOUSE_IDS=
# 【必填】请求方式：快麦该接口只认表单(x-www-form-urlencoded)，发 JSON 会忽略 cId
ERP_METHOD=POST
# 【选填】每页条数（最大 500）
ERP_PAGE_SIZE=500
# 【选填】真实“近30天销量”接口地址。默认由 ERP_API_URL 自动推导
# （把 …/stock/query/warehouseStockList 换成 …/stock/queryItemRelationInfo）。
# warehouseStockList 的 sale30Days 恒为 0，真实销量需这个接口按 sysItemId:sysSkuId:warehouseId 关联补回。
# ERP_RELATION_URL=https://viperp.superboss.cc/stock/queryItemRelationInfo
# 【选填】服务端口（默认 3000）
# PORT=3000