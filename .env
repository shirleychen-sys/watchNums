ERP_TOKEN=
ERP_API_KEY=

# 【必填·关键】公司/店铺 ID（cId）。快麦 warehouseStockList 靠它区分店铺，
# 不填会回退到默认(测试)店铺，看到的全是 测试2/菜鸟测试3 这类假数据。
# 取值：F12 → Network → 库存列表请求的 Request Payload 里的 cId
ERP_CID=4347622090

# 【选填】仓库 ID（warehouseIds）。留空=不限定；填了只拉该仓库。
# 取值同上，Payload 里的 warehouseIds。例：116959
ERP_WAREHOUSE_IDS=116959

# 【必填】请求方式：快麦该接口只认表单(x-www-form-urlencoded)，发 JSON 会忽略 cId
ERP_METHOD=POST

# 【选填】每页条数（最大 500）
ERP_PAGE_SIZE=500